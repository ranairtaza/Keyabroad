{
  "name": "keyabroad-monorepo",
  "packageManager": "npm@11.13.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node -e \"console.log('[Diagnostic: Before Turbo]', { NEXT_PUBLIC_SUPABASE_URL: Boolean(process.env.NEXT_PUBLIC_SUPABASE_URL), NEXT_PUBLIC_SUPABASE_ANON_KEY: Boolean(process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY) })\" && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:rls": "node --loader ts-node/esm tests/rls.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "node tests/security/adversarial.js",
    "test:smoke": "node tests/smoke-test.js",
    "test:load:setup": "node tests/load/setup.js"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "turbo": "^2.1.0"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "lodash": "^4.17.24"
  }
}
