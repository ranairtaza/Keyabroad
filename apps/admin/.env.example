# ==============================================================================
# KEYABROAD ADMIN PORTAL — ENVIRONMENT VARIABLES TEMPLATE (apps/admin)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials to version control.
# ==============================================================================

# --- SUPABASE CORE CONFIGURATION (REQUIRED) ---
# Supabase project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (Modern public client key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-placeholder

# Supabase Anon Key (Legacy public client key fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# --- SERVER-SIDE PRIVILEGED SECRETS (NEVER EXPOSE TO BROWSER) ---
# Supabase Secret Key (Modern administrative key for RLS bypass in server operations)
SUPABASE_SECRET_KEY=your-secret-key-placeholder

# Supabase Service Role Key (Legacy administrative fallback key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# --- WEBHOOK & CRON SECURITY SECRETS ---
# Supabase Database Webhook Secret (Header: x-supabase-webhook-secret)
SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret_here

# General Webhook / HMAC Signature Secret (Header: x-webhook-signature)
WEBHOOK_SECRET=your_general_webhook_secret_here

# Vercel Cron Job Secret (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_cron_job_secret_here

# --- INTEGRATIONS & THIRD-PARTY SERVICES ---
# LeadMachine Server-to-Server Integration Secret (Bearer token)
LEADMACHINE_INTEGRATION_SECRET=your_leadmachine_integration_secret_here

# OpenAI API Key (Server-side AI evaluations & processing)
OPENAI_API_KEY=your-openai-api-key-placeholder

# Upstash Redis REST Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

