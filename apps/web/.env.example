# ==============================================================================
# KEYABROAD WEB APP — ENVIRONMENT VARIABLES TEMPLATE (apps/web)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials to version control.
# ==============================================================================

# --- SUPABASE CORE CONFIGURATION (REQUIRED) ---
# Supabase project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (Modern public client key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# Supabase Anon Key (Legacy public client key fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key_here

# --- SERVER-SIDE SECRETS (SERVER-ONLY, NEVER EXPOSE TO CLIENT) ---
# Supabase Secret Key (Used for server API routes such as /api/chat)
SUPABASE_SECRET_KEY=sb_secret_placeholder_key_here

# Supabase Service Role Key (Legacy fallback)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_key_here

# --- OPTIONAL UPSTASH REDIS RATE LIMITING ---
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

