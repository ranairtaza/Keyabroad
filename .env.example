# ==============================================================================
# KEYABROAD MONOREPO — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real credentials to version control.
# ==============================================================================

# --- SUPABASE CORE CONFIGURATION (REQUIRED) ---
# Supabase project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (New Supabase key format, public safe)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# Supabase Anon Key (Legacy format, public safe fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key_here

# --- SERVER-SIDE PRIVILEGED SECRETS (NEVER EXPOSE TO BROWSER) ---
# Supabase Secret Key (Modern format, full RLS bypass for server routes)
SUPABASE_SECRET_KEY=sb_secret_placeholder_key_here

# Supabase Service Role Key (Legacy format, server-side fallback)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role_key_here

# --- WEBHOOK & CRON SECURITY SECRETS ---
# Supabase Database Webhook Secret (Header: x-supabase-webhook-secret)
SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret_here

# General Webhook / HMAC Signature Secret (Header: x-webhook-signature)
WEBHOOK_SECRET=your_general_webhook_secret_here

# Vercel Cron Job Secret (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_cron_job_secret_here

# --- INTEGRATIONS & THIRD-PARTY SERVICES ---
# LeadMachine Server-to-Server API Secret
LEADMACHINE_INTEGRATION_SECRET=your_leadmachine_integration_secret_here

# OpenAI API Key (Server-only AI processing)
OPENAI_API_KEY=sk-placeholder-openai-api-key-here

# Upstash Redis Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

